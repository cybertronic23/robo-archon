# Copy this file to .env and fill in your local settings.
# .env is ignored by Git; never put real credentials in this example.

# Required for DeepSeek LLM skill chat; not required for direct skill execution.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# For another OpenAI-compatible provider, omit DEEPSEEK_API_KEY and configure
# OPENAI_API_KEY, LLM_BASE_URL and LLM_MODEL for that provider.
# OPENAI_API_KEY=

# Optional Python override. Microduck defaults to .venv-microduck/bin/python
# and requires the pinned Python 3.12 environment. Use an absolute path if set.
# Replace /path/to/your/robo-archon with your own project directory if needed.
# ROBO_ARCHON_PYTHON=/path/to/your/robo-archon/.venv-microduck/bin/python
