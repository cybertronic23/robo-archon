<mujoco model="diff_car">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <joint damping="2" armature="0.01"/>
    <geom friction="1 0.5 0.1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="256" height="256"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".25 .3 .35" rgb2=".15 .18 .2" width="256" height="256"/>
    <material name="matplane" reflectance="0.2" texture="texplane" texrepeat="8 8"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="matplane"/>

    <!-- Goal marker -->
    <body name="goal" pos="1.2 0 0.05">
      <geom type="cylinder" size="0.08 0.02" rgba="0.2 0.8 0.3 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Planar base: x, y, yaw (position-actuated for simple demos) -->
    <body name="chassis" pos="0 0 0.08">
      <joint name="root_x" type="slide" axis="1 0 0" range="-4 4"/>
      <joint name="root_y" type="slide" axis="0 1 0" range="-4 4"/>
      <joint name="root_yaw" type="hinge" axis="0 0 1" range="-40 40"/>
      <geom type="box" size="0.18 0.12 0.05" rgba="0.15 0.45 0.85 1"/>
      <geom type="box" size="0.04 0.08 0.03" pos="0.16 0 0.02" rgba="0.9 0.8 0.1 1"/>
      <!-- Visual wheels -->
      <geom type="cylinder" size="0.06 0.03" pos="0.1 0.14 0" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.06 0.03" pos="0.1 -0.14 0" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.06 0.03" pos="-0.1 0.14 0" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.06 0.03" pos="-0.1 -0.14 0" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <camera name="chase" pos="-0.8 0 0.5" xyaxes="0 -1 0 0.4 0 1" fovy="50"/>
    </body>

    <camera name="scene" pos="0 -2.2 1.6" xyaxes="1 0 0 0 0.4 1" fovy="45"/>
  </worldbody>

  <actuator>
    <position name="act_x" joint="root_x" kp="120" ctrlrange="-4 4"/>
    <position name="act_y" joint="root_y" kp="120" ctrlrange="-4 4"/>
    <position name="act_yaw" joint="root_yaw" kp="80" ctrlrange="-40 40"/>
  </actuator>
</mujoco>
