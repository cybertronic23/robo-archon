/target/
debug/
**/*.rs.bk

# Build artifacts
*.d
*.rlib
*.dll
*.dylib
*.so
*.exe
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Editor / IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~
.DS_Store

# Environment
.env

# Claude Code
.claude/

# Local scripts
archon-rebuild.sh

# Temporary backups (e.g. offline lockfile rebuild)
*.bak
Cargo.lock.full.bak

# Legacy path (removed); keep ignore in case it reappears
/doc/

# Developer notes — not ready to publish; keep local for now
/notes/

# Local cargo vendor / home used for offline builds
/vendor/
/.cargo-home/
/.cargo-home-tmp/
/third_party/
/.cargo/

# Local Python envs for sim workers
.venv/
.venv-*/
venv/

# Local episode / demo video dumps
/tmp-episodes/
.archon_frames_*/
*.mp4
*.webm
*.mov
*.ppm
*.PPM

# Downloaded Menagerie / community MuJoCo assets (meshes)
/python/models/external/**
!/python/models/external/.gitkeep
!/python/models/external/README.md


__pycache__/
*.pyc

# Public gallery previews use size-limited GIFs; full videos stay local or in CI artifacts.

